POSTGRES_USER=catalog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=catalog

# Wajib, minimal 32 karakter. Generate dengan: openssl rand -base64 32
JWT_SECRET=

# Garage (object storage). Generate dengan: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Generate dengan: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# Access key bucket "assets", dibuat otomatis saat container pertama kali start
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=

# Grafana admin — k8s only, Grafana tidak berjalan di compose/. Nilai di sini
# dipakai ulang sebagai sumber Secret grafana-credentials di k8s/, pola sama
# seperti GARAGE_*. Nama variabel sengaja sama persis dengan env resmi Grafana
# (GF_SECURITY_*) supaya bisa langsung jadi kunci Secret tanpa translasi.
# Generate password dengan: openssl rand -base64 20
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
